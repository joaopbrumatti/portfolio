  (function () {
    var canvas = document.getElementById('hero-bg');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var section = canvas.parentElement;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var GAP = 28, w = 0, h = 0, mx = -9999, my = -9999, raf = 0, start = 0;

    // pontos do desenho (Homem Vitruviano, Leonardo da Vinci, domínio público)
    var flat = POINTS_STR.split(',').map(Number);
    var FIGURE = [];
    for (var i = 0; i < flat.length; i += 2) FIGURE.push({ tx: flat[i], ty: flat[i + 1] });
    // posição inicial espalhada, ângulo/raio próprios para a formação
    for (var i = 0; i < FIGURE.length; i++) {
      var ang = Math.random() * 6.2832, rad = 260 + Math.random() * 420;
      FIGURE[i].sx = Math.cos(ang) * rad;
      FIGURE[i].sy = Math.sin(ang) * rad;
      FIGURE[i].delay = Math.random() * 700;
      FIGURE[i].seed = Math.random() * 1000;
    }

    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

    function draw(t) {
      if (!start) start = t;
      ctx.clearRect(0, 0, w, h);

      // poeira de fundo
      for (var y = GAP / 2; y < h; y += GAP) {
        for (var x = GAP / 2; x < w; x += GAP) {
          var wave = (Math.sin(x * 0.011 + t * 0.0007) + Math.sin(y * 0.013 - t * 0.0009)) * 0.25 + 0.5;
          var a = 0.06 + wave * 0.1, r = 1, px = x, py = y, g = 0;
          var dx = x - mx, dy = y - my, d = Math.sqrt(dx * dx + dy * dy);
          if (d < 140 && d > 0) {
            g = 1 - d / 140;
            a += g * 0.55; r += g * 1.1;
            px += (dx / d) * g * 6; py += (dy / d) * g * 6;
          }
          ctx.fillStyle = 'rgba(' + Math.round(255 - g * 187) + ',' + Math.round(255 - g * 41) + ',' + Math.round(255 - g * 211) + ',' + a.toFixed(3) + ')';
          ctx.beginPath(); ctx.arc(px, py, r, 0, 6.2832); ctx.fill();
        }
      }

      // figura, só a partir de telas médias/grandes (esconde em celular, onde ela colidiria com o texto)
      if (w >= 760 && FIGURE.length) {
        var cx = w * 0.76, cy = h * 0.52;
        var size = Math.min(h * 0.64, w * 0.36);
        var fw = FIGURE_RATIO >= 1 ? size : size * FIGURE_RATIO;
        var fh = FIGURE_RATIO >= 1 ? size / FIGURE_RATIO : size;
        var ox = cx - fw / 2, oy = cy - fh / 2;

        var elapsed = t - start;
        for (var i = 0; i < FIGURE.length; i++) {
          var p = FIGURE[i];
          var local = Math.max(0, Math.min(1, (elapsed - p.delay) / 1400));
          var e = easeOutCubic(local);
          var tx = ox + p.tx * fw, ty = oy + p.ty * fh;
          var x = p.sx * (1 - e) + tx * e * 1 + (e < 1 ? 0 : 0);
          var y = p.sy * (1 - e) + ty * e;
          // reposiciona a origem relativa ao centro quando ainda espalhado
          if (local < 1) { x = (cx + p.sx) * (1 - e) + tx * e; y = (cy + p.sy) * (1 - e) + ty * e; }
          else {
            var breathe = Math.sin(t * 0.0012 + p.seed) * 1.1;
            x = tx; y = ty + breathe;
          }

          var r = 1.35, a = 0.62 + 0.28 * Math.sin(t * 0.0015 + p.seed);
          var dx = x - mx, dy = y - my, d = Math.sqrt(dx * dx + dy * dy), g = 0;
          if (d < 110 && d > 0) {
            g = 1 - d / 110;
            a = Math.min(1, a + g * 0.6); r += g * 1.4;
            x += (dx / d) * g * 5; y += (dy / d) * g * 5;
          }
          ctx.fillStyle = 'rgba(' + Math.round(255 - g * 187) + ',' + Math.round(255 - g * 41) + ',' + Math.round(255 - g * 211) + ',' + a.toFixed(3) + ')';
          ctx.beginPath(); ctx.arc(x, y, r, 0, 6.2832); ctx.fill();
        }
      }
    }

    function resize() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var r = section.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduce) draw(100000);
    }
    function loop(t) { draw(t); raf = requestAnimationFrame(loop); }

    new ResizeObserver(resize).observe(section);
    resize();
    if (!reduce) {
      raf = requestAnimationFrame(loop);
      document.addEventListener('visibilitychange', function () {
        cancelAnimationFrame(raf);
        if (!document.hidden) raf = requestAnimationFrame(loop);
      });
      window.addEventListener('pointermove', function (e) {
        var r = section.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
      }, { passive: true });
      document.addEventListener('pointerleave', function () { mx = my = -9999; });
    }
  })();
</script>
