<div class="lang-toggle" role="group" aria-label="Idioma / Language">
  <button type="button" data-lang-btn="pt" aria-pressed="true" aria-label="Português" title="Português">
    <svg viewBox="0 0 28 20" aria-hidden="true">
      <rect width="28" height="20" fill="#009c3b"/>
      <polygon points="14,2 25.5,10 14,18 2.5,10" fill="#ffdf00"/>
      <circle cx="14" cy="10" r="4.6" fill="#002776"/>
    </svg>
  </button>
  <button type="button" data-lang-btn="en" aria-pressed="false" aria-label="English" title="English">
    <svg viewBox="0 0 60 40" aria-hidden="true">
      <rect width="60" height="40" fill="#012169"/>
      <path d="M0,0 60,40M60,0 0,40" stroke="#fff" stroke-width="8"/>
      <path d="M0,0 60,40M60,0 0,40" stroke="#C8102E" stroke-width="2.6"/>
      <path d="M30,0V40M0,20H60" stroke="#fff" stroke-width="13"/>
      <path d="M30,0V40M0,20H60" stroke="#C8102E" stroke-width="7.5"/>
    </svg>
  </button>
</div>

<style>
  .lang-toggle{display:inline-flex;align-items:center;gap:6px}
  .lang-toggle button{display:block;padding:2px;border:1px solid transparent;background:none;cursor:pointer;opacity:.45;line-height:0;transition:opacity .2s,border-color .2s}
  .lang-toggle button:hover{opacity:.85}
  .lang-toggle button[aria-pressed="true"]{opacity:1;border-color:rgba(255,255,255,0.7)}
  .lang-toggle svg{display:block;width:24px;height:17px}
</style>
